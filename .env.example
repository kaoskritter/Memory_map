# Copy to .env.local for local development. In Vercel, add these under Project > Settings > Environment Variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Optional. Leave unset to use OpenStreetMap's public servers (fine for a small invite-only beta).
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=© OpenStreetMap contributors
# VITE_GEOCODE_URL=https://nominatim.openstreetmap.org/search
